# 复制为 .env 后按需填写。也可不写文件，改用 PUT /v1/config 在运行时配置。

# 监听
HOST=0.0.0.0
PORT=8787

# 可选：保护全部接口（除 GET /health）。配置后请求头带 Authorization: Bearer <token>
QIMEN_SERVICE_TOKEN=

# 大模型（OpenAI 兼容，含通义千问 Token Plan、DashScope compatible-mode、Ollama、vLLM）
QIMEN_LLM_ENABLED=1
QIMEN_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QIMEN_LLM_MODEL=qwen3.8-flash
QIMEN_LLM_API_KEY=

# 本地 Ollama 示例：
# QIMEN_LLM_BASE_URL=http://127.0.0.1:11434/v1
# QIMEN_LLM_MODEL=qwen2.5:7b
# QIMEN_LLM_API_KEY=ollama

# 区县天气权重文件（默认 models/qimen-district-weights-2020-2026.json）
# QIMEN_DISTRICT_WEIGHTS=
